---
import { safeEvidenceHref } from '../lib/safe-evidence-url.js';

interface Props {
  reference: string;
}

const { reference } = Astro.props;
const safeHref = safeEvidenceHref(reference);
---

{safeHref ? (
  <a href={safeHref}>preuve documentée</a>
) : (
  <span class="evidence-reference">{reference}</span>
)}
