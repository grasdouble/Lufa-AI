---
import SiteLayout from '../layouts/SiteLayout.astro';
import { artifacts, categories, environments } from '../data/catalog';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const searchableArtifacts = artifacts.map((artifact) => ({
  artifact,
  searchText: [
    artifact.id,
    artifact.name,
    artifact.description,
    artifact.type,
    ...artifact.discovery.categories,
    ...artifact.discovery.keywords,
    ...artifact.versions.flatMap((version) =>
      version.compatibilities.map(({ environment }) => environment),
    ),
  ].join(' '),
}));
---

<SiteLayout
  title="Catalogue"
  description="Découvrez et explorez les skills du catalogue public Lufa AI."
>
  <section class="hero" aria-labelledby="page-title">
    <p class="eyebrow">Des ressources ouvertes pour vos agents</p>
    <h1 id="page-title">
      Trouvez le bon <span>skill.</span>
    </h1>
    <p class="hero-copy">
      Explorez des artefacts versionnés, consultez leur contenu et leurs preuves
      de compatibilité avant de les installer avec la CLI Lufa.
    </p>
    <div class="catalog-meta">
      <span class="status-dot" aria-hidden="true"></span>
      {artifacts.length}{' '}
      {artifacts.length === 1 ? 'artefact disponible' : 'artefacts disponibles'}
      <span class="meta-divider" aria-hidden="true">
        /
      </span>
      <span>Sans compte · Consultation libre</span>
    </div>
  </section>

  <section class="catalog-section" aria-labelledby="catalog-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Explorer</p>
        <h2 id="catalog-heading">Le catalogue</h2>
      </div>
      <p class="section-note">
        Filtrez par mot-clé, type, environnement ou catégorie.
      </p>
    </div>

    <form
      class="filters"
      role="search"
      aria-label="Rechercher dans le catalogue"
      id="catalog-filters"
    >
      <label class="search-field" for="catalog-query">
        <span class="visually-hidden">Rechercher un artefact</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
          <circle cx="10.8" cy="10.8" r="6.8"></circle>
          <path d="m16 16 5 5"></path>
        </svg>
        <input
          id="catalog-query"
          name="q"
          type="search"
          placeholder="Nom, description, mot-clé…"
          autocomplete="off"
          aria-controls="artifact-list"
        />
      </label>
      <label class="select-field" for="filter-type">
        <span>Type</span>
        <select id="filter-type" name="type" aria-controls="artifact-list">
          <option value="">Tous les types</option>
          {[...new Set(artifacts.map((artifact) => artifact.type))]
            .sort()
            .map((type) => (
              <option value={type}>{type}</option>
            ))}
        </select>
      </label>
      <label class="select-field" for="filter-environment">
        <span>Environnement</span>
        <select
          id="filter-environment"
          name="environment"
          aria-controls="artifact-list"
        >
          <option value="">Tous les environnements</option>
          {environments.map((environment) => (
            <option value={environment}>{environment}</option>
          ))}
        </select>
      </label>
      <label class="select-field" for="filter-category">
        <span>Catégorie</span>
        <select
          id="filter-category"
          name="category"
          aria-controls="artifact-list"
        >
          <option value="">Toutes les catégories</option>
          {categories.map((category) => (
            <option value={category}>{category}</option>
          ))}
        </select>
      </label>
      <button class="visually-hidden" type="submit" tabindex="-1">
        Rechercher
      </button>
      <button class="reset-button" type="reset" form="catalog-filters">
        Effacer
      </button>
    </form>

    <p
      class="result-count"
      id="result-count"
      aria-live="polite"
      aria-atomic="true"
    >
      <span id="visible-count">{artifacts.length}</span>
      <span id="result-label">
        {artifacts.length === 1 ? 'résultat' : 'résultats'}
      </span>
    </p>

    {artifacts.length === 0 ? (
      <div class="empty-state" id="empty-catalog" role="status">
        <span class="empty-icon" aria-hidden="true">
          ◇
        </span>
        <h3>Le catalogue se prépare.</h3>
        <p>Aucun artefact n’est disponible pour le moment. Revenez bientôt.</p>
      </div>
    ) : (
      <div class="artifact-list" id="artifact-list">
        {searchableArtifacts.map(({ artifact, searchText }) => (
          <article
            class="artifact-card"
            data-artifact-card
            data-search={searchText}
            data-type={artifact.type}
            data-environments={artifact.versions
              .flatMap((version) =>
                version.compatibilities.map(({ environment }) => environment),
              )
              .join(' ')}
            data-categories={JSON.stringify(artifact.discovery.categories)}
          >
            <div class="card-topline">
              <span class="type-tag">{artifact.type}</span>
              <span class="latest-version">
                v{artifact.versions[0]?.version}
              </span>
            </div>
            <h3>
              <a href={`${baseUrl}/artifacts/${artifact.id}/`}>
                {artifact.name}
              </a>
            </h3>
            <p class="card-description">{artifact.description}</p>
            <ul class="tag-list" aria-label={`Catégories de ${artifact.name}`}>
              {artifact.discovery.categories.map((category) => (
                <li>{category}</li>
              ))}
            </ul>
            <div class="card-bottomline">
              <span>
                {artifact.versions[0]?.compatibilities.length ?? 0}{' '}
                environnements déclarés
              </span>
              <a
                class="card-link"
                href={`${baseUrl}/artifacts/${artifact.id}/`}
              >
                Voir le détail <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

    <div class="empty-state no-results" id="no-results" role="status" hidden>
      <span class="empty-icon" aria-hidden="true">
        ⌕
      </span>
      <h3>Aucun résultat pour cette recherche.</h3>
      <p>Essayez un autre terme ou modifiez les filtres sélectionnés.</p>
      <button class="text-button" type="reset" form="catalog-filters">
        Effacer les filtres
      </button>
    </div>
  </section>
</SiteLayout>

<script>
  import '../scripts/catalog-search.js';
</script>
