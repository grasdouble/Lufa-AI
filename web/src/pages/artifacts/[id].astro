---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import EvidenceReference from '../../components/EvidenceReference.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { artifacts, type CatalogArtifact } from '../../data/catalog';

const repositoryRoot = fileURLToPath(new URL('../../../../', import.meta.url));
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${baseUrl}/`;

export function getStaticPaths() {
  return artifacts.map((artifact) => ({
    params: { id: artifact.id },
    props: { artifact },
  }));
}

const { artifact } = Astro.props as { artifact: CatalogArtifact };
const versionsWithContent = await Promise.all(
  artifact.versions.map(async (version) => ({
    ...version,
    contents: await Promise.all(
      version.files.map(async (file) => ({
        ...file,
        content: await readFile(
          path.resolve(repositoryRoot, 'catalog', artifact.id, file.path),
          'utf8',
        ),
      })),
    ),
  })),
);
---

<SiteLayout title={artifact.name} description={artifact.description}>
  <div class="detail-page">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href={homeHref}>Catalogue</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{artifact.name}</span>
    </nav>

    <header class="detail-hero">
      <div class="detail-labels">
        <span class="type-tag">{artifact.type}</span>
        <span class="id-label">{artifact.id}</span>
      </div>
      <h1>{artifact.name}</h1>
      <p class="detail-description">{artifact.description}</p>
      <div class="install-command">
        <div>
          <span class="install-label">Pour installer avec la CLI</span>
          <code>lufa install {artifact.id}</code>
        </div>
        <span class="copy-note">Commande indicative</span>
      </div>
      <p class="read-only-note">
        Catalogue public en lecture seule. Cette commande est fournie à titre
        indicatif ; le site n’installe rien et n’exécute pas le contenu de
        l’artefact.
      </p>
    </header>

    <section class="info-panel" aria-labelledby="about-heading">
      <div class="section-heading compact-heading">
        <div>
          <p class="eyebrow">Source & maintenance</p>
          <h2 id="about-heading">À propos</h2>
        </div>
      </div>
      <dl class="provenance-grid">
        <div>
          <dt>Auteur(s)</dt>
          <dd>{artifact.authors.join(', ')}</dd>
        </div>
        <div>
          <dt>Licence</dt>
          <dd>{artifact.provenance.license}</dd>
        </div>
        <div class="source-entry">
          <dt>Provenance</dt>
          <dd>
            <a href={artifact.provenance.repository}>
              {artifact.provenance.repository}
            </a>
          </dd>
        </div>
        <div>
          <dt>Catégories</dt>
          <dd>{artifact.discovery.categories.join(', ') || 'Aucune'}</dd>
        </div>
      </dl>
    </section>

    <section class="versions-section" aria-labelledby="versions-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Historique du skill</p>
          <h2 id="versions-heading">Versions & compatibilité</h2>
        </div>
        <p class="section-note">
          Les versions sont présentées de la plus récente à la plus ancienne.
        </p>
      </div>

      <p class="proof-explainer">
        <span class="proof-badge declared">declared</span>
        signifie déclaré par l’auteur ;
        <span class="proof-badge verified">verified</span>
        signifie vérifié avec une preuve documentée par le projet. La validation
        des métadonnées ne prouve pas à elle seule le comportement d’un skill.
      </p>

      <div class="version-list">
        {versionsWithContent.map((version, index) => (
          <article class="version-card">
            <details open={index === 0}>
              <summary>
                <span class="version-heading">
                  <span class="version-number">v{version.version}</span>
                  {index === 0 && (
                    <span class="latest-pill">Dernière version</span>
                  )}
                </span>
                <time datetime={version.publishedAt}>
                  Publiée le{' '}
                  {new Intl.DateTimeFormat('fr-FR', {
                    dateStyle: 'long',
                    timeZone: 'UTC',
                  }).format(new Date(version.publishedAt))}
                </time>
              </summary>
              <div class="version-content">
                <section
                  class="version-subsection"
                  aria-labelledby={`compat-${version.version}`}
                >
                  <h3 id={`compat-${version.version}`}>
                    Compatibilités et preuves
                  </h3>
                  <ul class="compatibility-list">
                    {version.compatibilities.map((compatibility) => (
                      <li>
                        <span class="environment-name">
                          {compatibility.environment}
                        </span>
                        <span class={`proof-badge ${compatibility.level}`}>
                          {compatibility.level}
                        </span>
                        {compatibility.evidence && (
                          <p class="evidence-detail">
                            Testé avec {compatibility.evidence.testedVersion} ·
                            {compatibility.evidence.method} ·
                            <EvidenceReference
                              reference={compatibility.evidence.reference}
                            />
                          </p>
                        )}
                      </li>
                    ))}
                  </ul>
                </section>

                <div class="requirements-grid">
                  <section class="version-subsection">
                    <h3>Prérequis</h3>
                    {version.prerequisites.length ? (
                      <ul>
                        {version.prerequisites.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    ) : (
                      <p class="muted-copy">Aucun prérequis déclaré.</p>
                    )}
                  </section>
                  <section class="version-subsection warning-section">
                    <h3>Warnings</h3>
                    {version.warnings.length ? (
                      <ul>
                        {version.warnings.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    ) : (
                      <p class="muted-copy">Aucun avertissement déclaré.</p>
                    )}
                  </section>
                </div>

                <section class="version-subsection files-section">
                  <h3>Fichiers inclus</h3>
                  <ul class="file-list">
                    {version.files.map((file) => (
                      <li>
                        <code>{file.path}</code>
                        <span aria-hidden="true">→</span>
                        <code>{file.destination}</code>
                      </li>
                    ))}
                  </ul>
                </section>

                <section class="version-subsection content-section">
                  <h3>Contenu consultable</h3>
                  <p class="content-safety-note">
                    Texte brut pour inspection uniquement. Il n’est pas
                    interprété ni exécuté par le catalogue.
                  </p>
                  {version.contents.map((file) => (
                    <details class="content-file">
                      <summary>
                        <code>{file.path}</code>
                      </summary>
                      <pre><code>{file.content}</code></pre>
                    </details>
                  ))}
                </section>
              </div>
            </details>
          </article>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
