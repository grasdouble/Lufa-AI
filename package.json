{
  "name": "lufa-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.{js,ts}\" \"tests/**/*.js\" \"*.js\" \"*.json\" \"*.md\" \".github/**/*.yml\" \"docs/adr/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\" \"tests/**/*.js\" \"*.js\" \"*.json\" \"*.md\" \".github/**/*.yml\" \"docs/adr/**/*.md\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
