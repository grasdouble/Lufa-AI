{
  "name": "lufa-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.{js,ts}\" \"tests/**/*.js\" \"*.js\" \"*.json\" \"schemas/**/*.json\" \"catalog/**/*.{json,md}\" \"generated/**/*.json\" \"*.md\" \".github/**/*.yml\" \"docs/adr/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\" \"tests/**/*.js\" \"*.js\" \"*.json\" \"schemas/**/*.json\" \"catalog/**/*.{json,md}\" \"generated/**/*.json\" \"*.md\" \".github/**/*.yml\" \"docs/adr/**/*.md\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "catalog:validate": "node --experimental-strip-types src/catalog-command.ts validate",
    "catalog:build": "node --experimental-strip-types src/catalog-command.ts build",
    "catalog:check": "node --experimental-strip-types src/catalog-command.ts check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run catalog:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
