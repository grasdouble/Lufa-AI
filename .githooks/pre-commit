#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

build_inputs='src/ tsconfig.json package.json package-lock.json scripts/build.js scripts/build-lib.js'

if ! git diff --quiet -- $build_inputs; then
  cat >&2 <<'EOF'
Le hook pre-commit refuse de compiler : des sources de build ont des changements
non stagés. Stagez ou annulez ces changements avant de committer, afin que dist/
corresponde aux sources qui entreront dans le commit.
EOF
  exit 1
fi

untracked_inputs=$(git ls-files --others --exclude-standard -- $build_inputs)
if [ -n "$untracked_inputs" ]; then
  cat >&2 <<'EOF'
Le hook pre-commit refuse de compiler : des fichiers de build sont non suivis.
Ajoutez-les au suivi Git avant de committer afin que dist/ corresponde aux
sources qui entreront dans le commit.
EOF
  printf '%s\n' "$untracked_inputs" >&2
  exit 1
fi

npm run build
git add -f -A -- dist/
